# Copy to infra/.env and adjust. infra/.env is git-ignored.

# PostgreSQL
POSTGRES_DB=fatoora
POSTGRES_USER=fatoora
POSTGRES_PASSWORD=fatoora
POSTGRES_PORT=5432

# Mailpit (local SMTP catcher)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# S3-compatible storage (RustFS locally)
S3_ACCESS_KEY=fatoora
S3_SECRET_KEY=fatoora-secret
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=fatoora
