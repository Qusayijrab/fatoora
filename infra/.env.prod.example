# Copy to infra/.env.prod and replace every value. Never commit the real file.
PUBLIC_URL=https://invoices.example.com
DB_PASSWORD=change-me-long-random
JWT_SECRET=change-me-at-least-32-random-characters
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-long-random
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=invoices@example.com
# stripe = real payments (set both Stripe values below).
# mock = fake checkout where anyone with a pay link can mark an invoice paid. Only for a
# public demo, and only together with PAYMENTS_MOCK_ENABLED=true.
PAYMENTS_PROVIDER=stripe
PAYMENTS_MOCK_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
