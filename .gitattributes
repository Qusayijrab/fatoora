# Normalize all text files to LF in the repo and in the working tree.
* text=auto eol=lf

# Windows batch files need CRLF or cmd.exe can misread them (e.g. mvnw.cmd).
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.jar binary
*.zip binary
